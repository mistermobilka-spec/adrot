# Minimal Active-Directory-shaped schema for the ADRot integration test server.
#
# Written directly in cn=config form so no schema conversion tool is needed at image
# build time — one less dependency that can vanish from a base image.
#
# OpenLDAP does not ship the AD attributes ADRot reads, so we declare just enough of
# them to exercise the real LDAP code path: bind, paged search, attribute extraction
# and binary SID decoding, against a genuine LDAP server speaking the real protocol.
#
# THESE OIDS ARE FAKE. They live under a private experimental arc, are not the real
# Microsoft OIDs, and must never be loaded into a production directory.
dn: cn=adrottest,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: adrottest
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1 NAME 'sAMAccountName' DESC 'AD-style logon name' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.2 NAME 'userAccountControl' DESC 'AD-style account control bit field' EQUALITY integerMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.3 NAME 'pwdLastSet' DESC 'FILETIME of the last password change' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.4 NAME 'lastLogonTimestamp' DESC 'FILETIME of the last replicated logon' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.5 NAME 'adminCount' DESC 'AdminSDHolder stamp' EQUALITY integerMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.27 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.6 NAME 'servicePrincipalName' DESC 'Kerberos SPN' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.7 NAME 'operatingSystem' DESC 'Reported operating system name' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.8 NAME 'operatingSystemVersion' DESC 'Reported operating system version' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.9 NAME 'objectSid' DESC 'Binary security identifier' EQUALITY octetStringMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.40 SINGLE-VALUE )
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.10 NAME 'objectCategory' DESC 'AD-style object category' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcObjectClasses: ( 1.3.6.1.4.1.99999.2.1 NAME 'adRotPrincipal' DESC 'Auxiliary class carrying the AD-shaped attributes ADRot reads' SUP top AUXILIARY MAY ( sAMAccountName $ userAccountControl $ pwdLastSet $ lastLogonTimestamp $ adminCount $ servicePrincipalName $ operatingSystem $ operatingSystemVersion $ objectSid $ objectCategory ) )
