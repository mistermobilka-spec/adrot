# ADRot environment configuration
# Copy to .env and adjust. Every value is optional — ADRot auto-discovers a
# domain-joined machine's own domain when these are unset.
#
# NOTE: ADRot never needs, stores, or transmits a password. Authentication uses
# the Negotiate (Kerberos/NTLM) identity of the process that runs it. There is
# deliberately no ADROT_PASSWORD variable.

# LDAP server to query. Hostname of a domain controller, or the domain DNS name
# (which resolves to any available DC). Leave unset to auto-discover.
ADROT_SERVER=dc01.corp.example.com

# LDAP port. 389 = LDAP, 636 = LDAPS. Default 389 with sign+seal.
ADROT_PORT=389

# Force LDAPS (TLS). "true" implies port 636 unless ADROT_PORT is set.
ADROT_USE_SSL=false

# Search base. Defaults to the domain naming context of ADROT_SERVER.
ADROT_SEARCH_BASE=DC=corp,DC=example,DC=com

# Days after which an enabled account with no logon is considered stale.
ADROT_STALE_DAYS=90

# Days after which the krbtgt password is considered overdue for rotation.
ADROT_KRBTGT_MAX_AGE_DAYS=180

# Maximum acceptable number of members in Domain/Enterprise/Schema Admins.
ADROT_MAX_PRIVILEGED_MEMBERS=5

# Minimum acceptable domain password length.
ADROT_MIN_PASSWORD_LENGTH=14

# Fail the process (exit code 2) if any finding at or above this severity is
# present. One of: Critical, High, Medium, Low, None. "None" never fails.
ADROT_FAIL_ON=None

# Logging verbosity: Debug, Info, Warn, Error
ADROT_LOG_LEVEL=Info
